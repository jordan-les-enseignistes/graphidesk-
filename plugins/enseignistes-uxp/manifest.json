{
  "manifestVersion": 5,
  "id": "com.izy.enseignistes",
  "name": "BAT Les Enseignistes",
  "version": "6.2.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "21.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "icons": [
    {
      "width": 24, "height": 24,
      "path": "icons/iconlist.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "BAT Les Enseignistes" },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"], "species": ["chrome"] },
        { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["chrome"] }
      ],
      "minimumSize": { "width": 230, "height": 160 },
      "maximumSize": { "width": 1000, "height": 1200 },
      "preferredDockedSize": { "width": 320, "height": 520 },
      "preferredFloatingSize": { "width": 340, "height": 600 }
    }
  ]
}
